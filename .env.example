# PostgreSQL Neon Serverless Connection String (SecretString wrapped)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require

# Asymmetric Ed25519 JWT Seed Key (SecretString wrapped)
JWT_SECRET_SEED=coffee_labs_ed25519_enterprise_seed_key_2026_v2

# Server Port & Environment
PORT=3000
APP_ENV=production

# Rate Limiter (tower_governor & sliding window)
RATE_LIMIT_PER_SEC=30
RATE_LIMIT_BURST=100

# Structured Logging
RUST_LOG=info,coffe_labs_backend=debug
