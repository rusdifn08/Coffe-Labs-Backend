# PostgreSQL Neon Serverless Connection String (SecretString wrapped)
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloud / Hosted Redis URL (Opsional: jika kosong, fallback ke In-Memory Single-Node)
REDIS_URL=redis://default:password@example.db.redis.io:18473

# CloudAMQP RabbitMQ Free Plan ("Little Lemur") TLS Connection String
RABBITMQ_URL=amqps://user:password@armadillo.rmq.cloudamqp.com/vhost

# Firebase Cloud Messaging (FCM v1 HTTP/2)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
FCM_PROJECT_ID=coffe-labs

# Cloudinary Direct Signed Upload (Zero-RAM Client-to-CDN Upload)
CLOUDINARY_URL=cloudinary://api_key:api_secret@irn72dwa

# Asymmetric Ed25519 JWT Seed Key (SecretString wrapped)
JWT_SECRET_SEED=coffee_labs_ed25519_enterprise_seed_key_2026_v2

# Server Port & Environment
PORT=3000
APP_ENV=production

# Rate Limiter (tower_governor & sliding window)
RATE_LIMIT_PER_SEC=30
RATE_LIMIT_BURST=100

# Structured Logging
RUST_LOG=info,coffe_labs_backend=debug
